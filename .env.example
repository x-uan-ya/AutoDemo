# AutoDemo environment configuration
# Copy this file to .env.local and fill in values as capabilities are added.
# In this foundation milestone, none of these are required to run the app.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the app (used for absolute links later).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - not yet wired up. The app currently uses an
# in-memory repository. When the Postgres layer lands, set this connection
# string and the repository will read/write here instead.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/autodemo

# ---------------------------------------------------------------------------
# AI provider (Feature Discovery)
# ---------------------------------------------------------------------------
# Which multimodal AI provider to use. Options: "bedrock" or "mock".
# If unset, AutoDemo uses Amazon Bedrock when an AWS region is configured,
# otherwise it falls back to a deterministic, evidence-only mock provider so
# the app runs with zero cloud setup.
# AUTODEMO_AI_PROVIDER=bedrock

# Amazon Bedrock configuration (used when the provider is bedrock).
# AWS credentials are read from the standard AWS credential chain
# (environment, shared config, or instance/role). Do not hard-code secrets.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Text-to-Speech (Phase 6 — voice narration)
# ---------------------------------------------------------------------------
# Which TTS provider to use. Options: "polly" or "mock".
# If unset, AutoDemo uses Amazon Polly when an AWS region is configured,
# otherwise it falls back to an offline mock that writes silent MP3s so the
# app and its audio players work with zero cloud setup.
# AUTODEMO_TTS_PROVIDER=polly
# Amazon Polly uses AWS_REGION and the standard AWS credential chain (above).

# ---------------------------------------------------------------------------
# Future capability integrations (placeholders — not used yet)
# ---------------------------------------------------------------------------

# Object storage for recordings and rendered video assets.
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Security resource limits (optional overrides)
# ---------------------------------------------------------------------------
# These bound how much CPU, memory, browser time, storage, and AI spend a
# single request or job can consume, protecting the server from abuse and
# denial-of-service. All have safe built-in defaults (see src/lib/security/
# limits.ts); set them here only to tune for your environment. Each value must
# be a positive integer; invalid values fall back to the default.

# Maximum length of a user-submitted URL (characters). Default: 2048
# MAX_URL_LENGTH=2048

# Maximum pages a single exploration may open. Default: 1
# MAX_PAGES_PER_EXPLORATION=1

# Maximum crawl depth (reserved for future multi-page crawling). Default: 1
# MAX_CRAWL_DEPTH=1

# Hard cap on total browser wall-clock time per operation (ms). Default: 120000
# MAX_BROWSER_TIME_MS=120000

# Maximum browser actions in a single demo. Default: 60
# MAX_ACTIONS_PER_DEMO=60

# Maximum rendered video duration (seconds). Default: 300
# MAX_VIDEO_DURATION_S=300

# Maximum size for any single generated/served file (bytes). Default: 209715200
# MAX_FILE_SIZE_BYTES=209715200

# Maximum concurrent heavy jobs (browser/record/render) server-wide. Default: 2
# MAX_CONCURRENT_JOBS=2

# Maximum AI/vision/TTS calls attributable to a single job. Default: 40
# MAX_AI_CALLS_PER_JOB=40

# Maximum JSON request body size accepted by API routes (bytes). Default: 262144
# MAX_REQUEST_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Authentication & sessions
# ---------------------------------------------------------------------------
# AutoDemo now uses email/password authentication with server-side sessions.
# The session id lives in a Secure, HttpOnly, SameSite=Lax cookie; a readable
# companion cookie carries the CSRF token (double-submit). Passwords are hashed
# with scrypt (node:crypto) — never stored or logged in plaintext.

# Session lifetime in milliseconds. Default: 43200000 (12 hours).
# SESSION_TTL_MS=43200000

# NOTE on cookie Secure flag: cookies are marked Secure and use the __Host-
# prefix automatically when NODE_ENV=production (HTTPS required). In
# development (localhost over http) Secure is off so login works. You do not
# set this manually.

# IMPORTANT: the current session and user stores are IN-MEMORY (per process).
# All sessions and accounts are lost on restart and are NOT shared across
# instances. Before production with more than one instance, back the session
# store and user store with a shared database/Redis (interfaces are ready).

# ---------------------------------------------------------------------------
# CORS allowlist
# ---------------------------------------------------------------------------
# The API is credentialed (session cookie), so wildcard CORS is forbidden.
# Same-origin calls from the AutoDemo UI need nothing here. To allow specific
# additional browser origins to call the API with credentials, list them here
# (comma-separated, exact scheme+host+port). Unlisted origins receive no CORS
# headers and are blocked by the browser. NEXT_PUBLIC_APP_URL is always trusted.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# CSRF note
# ---------------------------------------------------------------------------
# CSRF protection is ENFORCED on all state-changing API requests (POST/PUT/
# PATCH/DELETE): the client must echo the session CSRF token in the
# `x-csrf-token` header. The provided apiFetch() client helper does this
# automatically. SameSite=Lax on the session cookie is the first line of
# defense; the token is defense in depth. Do not disable it for same-origin
# calls.

# ---------------------------------------------------------------------------
# Browser worker network isolation (SSRF / DNS-rebinding defense in depth)
# ---------------------------------------------------------------------------
# The browser worker runs Chromium against UNTRUSTED websites. Application-level
# URL validation is defense in depth only and does NOT fully eliminate DNS
# rebinding. Production MUST run the browser worker in an isolated subnet/VPC
# with network-level egress controls that make private/internal ranges and
# cloud metadata endpoints unreachable. See SECURITY.md ("Browser Network
# Isolation") and DEPLOYMENT.md (checklist + templates). This is a DEPLOYMENT
# INFRASTRUCTURE requirement — these variables do not enforce it.

# Optional: force ALL browser egress through a controlled forward proxy. The
# proxy/firewall (not the app) then enforces the egress allow policy regardless
# of DNS. Example: http://egress-proxy.internal:3128
# BROWSER_PROXY_SERVER=

# Optional: hosts that bypass the proxy (Playwright proxy.bypass format).
# BROWSER_PROXY_BYPASS=
