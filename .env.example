# AutoDemo environment configuration
# Copy this file to .env.local and fill in values as capabilities are added.
# In this foundation milestone, none of these are required to run the app.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the app (used for absolute links later).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - not yet wired up. The app currently uses an
# in-memory repository. When the Postgres layer lands, set this connection
# string and the repository will read/write here instead.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/autodemo

# ---------------------------------------------------------------------------
# AI provider (Feature Discovery)
# ---------------------------------------------------------------------------
# Which multimodal AI provider to use. Options: "bedrock" or "mock".
# If unset, AutoDemo uses Amazon Bedrock when an AWS region is configured,
# otherwise it falls back to a deterministic, evidence-only mock provider so
# the app runs with zero cloud setup.
# AUTODEMO_AI_PROVIDER=bedrock

# Amazon Bedrock configuration (used when the provider is bedrock).
# AWS credentials are read from the standard AWS credential chain
# (environment, shared config, or instance/role). Do not hard-code secrets.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Text-to-Speech (Phase 6 — voice narration)
# ---------------------------------------------------------------------------
# Which TTS provider to use. Options: "polly" or "mock".
# If unset, AutoDemo uses Amazon Polly when an AWS region is configured,
# otherwise it falls back to an offline mock that writes silent MP3s so the
# app and its audio players work with zero cloud setup.
# AUTODEMO_TTS_PROVIDER=polly
# Amazon Polly uses AWS_REGION and the standard AWS credential chain (above).

# ---------------------------------------------------------------------------
# Future capability integrations (placeholders — not used yet)
# ---------------------------------------------------------------------------

# Object storage for recordings and rendered video assets.
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
